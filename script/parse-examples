#!/usr/bin/env bash
# Parses every .sql file of the repositories in script/examples.txt, each at its
# pinned commit, and fails if one of them has an ERROR or MISSING node.
set -euo pipefail
cd "$(dirname "$0")/.."
dir=examples
mkdir -p "$dir"
grep -v '^#' script/examples.txt | while read -r repo sha; do
  [ -n "$repo" ] || continue
  dest="$dir/${repo#*/}"
  if [ ! -d "$dest/.git" ]; then
    git init -q "$dest"
    git -C "$dest" remote add origin "https://github.com/$repo.git"
  fi
  git -C "$dest" fetch -q --depth 1 origin "$sha"
  git -C "$dest" checkout -q --detach FETCH_HEAD
done
find "$dir" -name '*.sql' -not -path '*/.git/*' | sort > "$dir/files.txt"
tree-sitter parse --quiet --stat --paths "$dir/files.txt"
